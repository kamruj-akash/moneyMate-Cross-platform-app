# Copy this file to `.env` and fill in your own Supabase project values.
#
# Both values come from your Supabase Dashboard → Project Settings → API.
# The publishable / anon key is safe to expose in the client bundle; what
# you must NEVER put here (or anywhere in source control) is the
# `service_role` key — that bypasses Row Level Security.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
